+#else
+#define N64_POP_PCT 100
+#endif
+
+// Pedestrians: their own percentage (cars stay at N64_POP_PCT). Lower = fewer people on screen.
+// On N64 it is chosen on the Options page: low, medium or high (Char_Pool.cpp).
+#ifdef N64
+extern "C" int gta2_n64_ped_pct(void);
+#define N64_PED_PCT gta2_n64_ped_pct()
+#else
+#define N64_PED_PCT 100
+#endif
+
+// ---- CHAOS CAPS (N64): limits for chaotic scenes (police/SWAT, fire) ----
+// PC (original): police teams 20, emergency peds 30, particles = only the pool limit.
+#ifdef N64
+#define N64_CAP_POLICE_TEAMS 6   // police teams active at once (max 20 in the original)
+#define N64_CAP_EMERGENCY_PEDS 14  // police/SWAT/FBI/medics alive (original 30; SWAT only spawns below this minus 4)
+#define N64_CAP_PARTICLES      160 // live fire, smoke and blood particles/sprites (per tick)
+#else
+#define N64_CAP_POLICE_TEAMS 20
+#define N64_CAP_EMERGENCY_PEDS 30
+#define N64_CAP_PARTICLES      100000
+#endif
+
